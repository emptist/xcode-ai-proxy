# Xcode AI Proxy 环境变量配置示例
# 复制此文件为 .env 并填入真实的 API 密钥

# ===================
# API 密钥配置
# ===================

# 智谱AI GLM-4.5 模型配置
# 获取地址: https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4

# Kimi AI 配置
# 获取地址: https://platform.moonshot.cn/
KIMI_API_KEY=your_kimi_api_key_here
KIMI_API_URL=https://api.moonshot.cn/v1

# Google Gemini 配置
# 获取地址: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai

# 通义千问 QWen 配置
# 获取地址: https://dashscope.console.aliyun.com/
QWEN_API_KEY=your_qwen_api_key_here
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenCode Zen 免费模型配置
# 官方文档: https://opencode.ai/docs/zen/
# 
# 免费使用（无需配置）:
# - 默认使用 "public" 作为 API Key
# - 支持模型: big-pickle, gpt-5-nano, glm-4.7-free, grok-code, minimax-m2.1-free 等
# - 限制: 约 8-10 次/分钟
#
# 获取更好配额:
# 1. 访问 https://opencode.ai/auth 登录
# 2. 添加支付信息（按使用付费，免费模型仍免费）
# 3. 复制 API Key 配置到下方
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_API_URL=https://opencode.ai/zen/v1

# OpenRouter 多模型聚合配置
# 官方文档: https://openrouter.ai/docs
# 
# 特点:
# - 统一 API 访问 200+ 模型 (OpenAI, Anthropic, Google, Meta 等)
# - 按使用付费，部分免费模型
# - 免费模型: deepseek-r1, deepseek-v3, llama-3.3-70b, qwen-2.5-72b 等
#
# 获取 API Key:
# 1. 访问 https://openrouter.ai/
# 2. 注册登录后进入 Keys 页面
# 3. 创建新的 API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# 自定义系统提示（可选）
# 示例: 你是一个专业的Swift开发助手，专门帮助iOS和macOS开发。
# CUSTOM_SYSTEM_PROMPT=your_custom_system_prompt_here

# ===================
# 服务器配置
# ===================

# 服务器端口 (默认: 9988)
PORT=9988

# 服务器主机 (默认: 0.0.0.0)
HOST=0.0.0.0

# ===================
# 重试配置
# ===================

# API 请求重试次数 (默认: 3)
MAX_RETRIES=3

# 重试延迟基数，单位毫秒 (默认: 1000)
# 实际延迟 = RETRY_DELAY * 重试次数
RETRY_DELAY=1000

# 请求超时时间，单位毫秒 (默认: 60000)
REQUEST_TIMEOUT=60000